# Скопируйте в /etc/mdpravo/env (права 600, владелец mdpravo). Не коммитьте реальные значения.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
BASE_URL=https://mdpravo.ru
TRUST_PROXY=1

# Случайная строка ≥ 32 символов: openssl rand -base64 48
SECRET_KEY=

DB_PATH=/var/lib/mdpravo/app.sqlite
STORAGE_DIR=/var/lib/mdpravo/storage
UPLOAD_MAX_MB=20
SESSION_DAYS=14

# Почта для кодов входа и уведомлений (порт 465 — TLS, 587 — STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Мосдевелопмент Право <mail@mdpravo.ru>"
# Куда приходят уведомления о новых обращениях (без персональных данных в письме)
REQUESTS_NOTIFY_EMAIL=

# Оплата: yookassa (production) | test (только разработка)
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать чек 54-ФЗ (если включено в магазине ЮKassa); код НДС по справочнику ЮKassa
YOOKASSA_RECEIPTS=0
YOOKASSA_VAT_CODE=1
# Диапазоны IP уведомлений ЮKassa через запятую — взять из актуальной документации ЮKassa.
# Пусто — проверка по IP выключена (статус всё равно подтверждается запросом к API).
YOOKASSA_WEBHOOK_IPS=

YANDEX_METRIKA_ID=
